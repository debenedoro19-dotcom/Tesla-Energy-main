<span class="line"><span style="color: rgb(156, 220, 254);">  scrolled</span></span>
<span class="line"><span style="color: rgb(212, 212, 212);">    ? </span><span style="color: rgb(206, 145, 120);">"border-white/10 bg-black/70 backdrop-blur-xl"</span></span>
