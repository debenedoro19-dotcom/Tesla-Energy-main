    :host {
      all: initial;
      position: fixed;
      z-index: 2147483646;
      display: inline-flex;
      align-items: center;
      pointer-events: auto;
    }

    .sbpo-shell {
      position: relative;
      display: inline-flex;
      align-items: center;
      z-index: 2147483647;
      isolation: isolate;
    }

    :host(.sbpo-hidden) {
      display: none;
    }

    :host(.sbpo-inline) {
      position: relative;
      z-index: 2147483646;
      margin-right: 4px;
      align-self: center;
      isolation: isolate;
    }

    .sbpo-optimize {
      all: unset;
      box-sizing: border-box;
      width: 32px;
      height: 32px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(119, 119, 119, 0.47);
      color: #ffffff;
      position: relative;
      z-index: 2147483647;
      pointer-events: auto;
      overflow: visible;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 0 0 1px rgba(0, 0, 0, 0.12),
        0 2px 8px rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(10px) saturate(130%);
      -webkit-backdrop-filter: blur(10px) saturate(130%);
      transition: background 140ms ease, transform 140ms ease, opacity 140ms ease, color 140ms ease;
    }

    .sbpo-optimize svg {
      width: 16px;
      height: 16px;
      display: block;
    }

    .sbpo-optimize-image {
      width: 16px;
      height: 16px;
      display: block;
      object-fit: contain;
      pointer-events: none;
    }

    .sbpo-optimize:hover {
      transform: translateY(-1px);
      background: rgba(96, 96, 96, 0.58);
    }

    .sbpo-optimize[data-open="true"] {
      background: rgba(86, 86, 86, 0.64);
      transform: translateY(-1px);
    }

    .sbpo-optimize:disabled {
      cursor: default;
      opacity: 0.72;
      transform: none;
    }

    .sbpo-menu {
      position: fixed;
      top: 0;
      left: 0;
      width: min(264px, calc(100vw - 24px));
      padding: 10px;
      border-radius: 18px;
      background: rgba(20, 20, 20, 0.92);
      color: #f7f7f7;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: grid;
      gap: 8px;
      transform-origin: top right;
      z-index: 2147483647;
    }

    .sbpo-menu[hidden] {
      display: none;
    }

    .sbpo-menu-item {
      all: unset;
      box-sizing: border-box;
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      cursor: pointer;
      color: inherit;
      text-align: left;
      transition: background 120ms ease, opacity 120ms ease;
    }

    .sbpo-menu-item[hidden] {
      display: none !important;
    }

    .sbpo-menu-item:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .sbpo-menu-item:disabled {
      cursor: default;
      opacity: 0.45;
    }

    .sbpo-menu-item svg {
      width: 18px;
      height: 18px;
      display: block;
      margin-top: 1px;
    }

    .sbpo-menu-copy {
      min-width: 0;
      display: grid;
      gap: 4px;
    }

    .sbpo-menu-label {
      font-size: 13px;
      font-weight: 700;
      line-height: 1.3;
      white-space: normal;
    }

    .sbpo-menu-hint {
      font-size: 12px;
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.72);
      white-space: normal;
