<span style="color: rgb(128, 128, 128);">&gt;</span><span style="color: rgb(230, 230, 230);"> */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">&lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"pointer-events-none fixed inset-0 -z-10 overflow-hidden"</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
