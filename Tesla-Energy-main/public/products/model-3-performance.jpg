      height: 18px;
    }

    :host(.sbpo-copilot) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    @keyframes sbpo-spin-fast {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes sbpo-glow-pulse {
      0% {
        transform: scale(0.95);
        opacity: 0.56;
      }
      55% {
        transform: scale(1.05);
        opacity: 0.92;
      }
      100% {
        transform: scale(0.95);
        opacity: 0.56;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :host([data-sb-state="loading"]) .sbpo-optimize .sbpo-optimize-image,
      :host([data-sb-state="loading"]) .sbpo-optimize::before,
      :host([data-sb-state="loading"]) .sbpo-optimize::after {
        animation: none;
      }
    }
  </style><div class="sbpo-menu" hidden=""><button type="button" class="sbpo-menu-item" disabled=""><span class="sbpo-menu-icon"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.5 2.1a.8.8 0 0 1 .76.55l.73 2.19a3.4 3.4 0 0 0 2.16 2.16l2.19.73a.8.8 0 0 1 0 1.52l-2.19.73a3.4 3.4 0 0 0-2.16 2.16l-.73 2.19a.8.8 0 0 1-1.52 0l-.73-2.19a3.4 3.4 0 0 0-2.16-2.16l-2.19-.73a.8.8 0 0 1 0-1.52l2.19-.73a3.4 3.4 0 0 0 2.16-2.16l.73-2.19a.8.8 0 0 1 .76-.55Z"></path></svg></span><span class="sbpo-menu-copy"><span class="sbpo-menu-label">Optimize prompt</span><span class="sbpo-menu-hint">Rewrite the current draft and keep undo available.</span></span></button><button type="button" class="sbpo-menu-item" hidden="" disabled=""><span class="sbpo-menu-icon"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.35 3.45A6.8 6.8 0 0 1 16.15 10a.75.75 0 0 1-1.5 0A5.3 5.3 0 0 0 5.6 6.26l1.77.01a.75.75 0 0 1 0 1.5H3.78a.75.75 0 0 1-.75-.75V3.43a.75.75 0 0 1 1.5 0v1.76a6.76 6.76 0 0 1 4.82-1.74ZM3.85 10a.75.75 0 0 1 1.5 0A5.3 5.3 0 0 0 14.4 13.74l-1.77-.01a.75.75 0 0 1 0-1.5h3.59c.41 0 .75.34.75.75v3.59a.75.75 0 0 1-1.5 0v-1.76A6.76 6.76 0 0 1 10.65 16.55 6.8 6.8 0 0 1 3.85 10Z"></path></svg></span><span class="sbpo-menu-copy"><span class="sbpo-menu-label">Undo</span><span class="sbpo-menu-hint">Restore the original draft from the last optimization.</span></span></button><button type="button" class="sbpo-menu-item" disabled=""><span class="sbpo-menu-icon"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M5.5 2.6A2.4 2.4 0 0 0 3.1 5v11.2c0 .64.73 1 1.24.6L10 12.54l5.66 4.26c.5.38 1.24.03 1.24-.6V5a2.4 2.4 0 0 0-2.4-2.4h-9Z"></path></svg></span><span class="sbpo-menu-copy"><span class="sbpo-menu-label">Save prompt</span><span class="sbpo-menu-hint">Bookmark the current draft to revisit it later.</span></span></button><button type="button" class="sbpo-menu-item"><span cla