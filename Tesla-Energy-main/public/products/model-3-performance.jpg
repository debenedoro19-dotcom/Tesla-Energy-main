<span class="line"><span style="color: rgb(128, 128, 128);">  &lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"absolute top-20 right-10 md:right-20 w-72 h-72 md:w-96 md:h-96 rounded-full bg-[#E82127]/15 blur-3xl opacity-40 animate-pulse"</span><span style="color: rgb(244, 71, 71);"> /</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  {/* Bottom-left glow */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">  &lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"absolute bottom-32 left-4 md:left-10 w-64 h-64 md:w-80 md:h-80 rounded-full bg-[#E82127]/10 blur-3xl opacity-30 animate-pulse"</span><span style="color: rgb(156, 220, 254);"> style</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">{{</span><span style="color: rgb(156, 220, 254);"> animationDelay:</span><span style="color: rgb(244, 71, 71);"> "1.5s"</span><span style="color: rgb(156, 220, 254);"> }}</span><span style="color: rgb(244, 71, 71);"> /</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  {/* Center soft bloom */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">  &lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-[#E82127]/5 blur-3xl opacity-20"</span><span style="color: rgb(244, 71, 71);"> /</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  {/* Optional cyan secondary for cyber feel */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">  &lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"absolute top-1/3 right-1/4 w-48 h-48 rounded-full bg-cyan-400/10 blur-3xl opacity-25 animate-pulse"</span><span style="color: rgb(156, 220, 254);"> style</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">{{</span><span style="color: rgb(156, 220, 254);"> animationDelay:</span><span style="color: rgb(244, 71, 71);"> "0.8s"</span><span style="color: rgb(156, 220, 254);"> }}</span><span style="color: rgb(244, 71, 71);"> /</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
