<span class="line"><span style="color: rgb(156, 220, 254);">  style</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">{{</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">    backgroundImage:</span><span style="color: rgb(244, 71, 71);"> "url('/products/cybertruck.jpg')",</span><span style="color: rgb(244, 71, 71);"> /*</span><span style="color: rgb(156, 220, 254);"> or</span><span style="color: rgb(156, 220, 254);"> your</span><span style="color: rgb(156, 220, 254);"> best</span><span style="color: rgb(156, 220, 254);"> hero</span><span style="color: rgb(156, 220, 254);"> image</span><span style="color: rgb(156, 220, 254);"> *</span><span style="color: rgb(244, 71, 71);">/</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">    backgroundAttachment:</span><span style="color: rgb(244, 71, 71);"> "fixed",</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">  }}</span></span>
<span class="line"><span style="color: rgb(244, 71, 71);">/</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">{/* Dark gradient veil so text stays readable */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">&lt;</span><span style="color: rgb(86, 156, 214);">div</span><span style="color: rgb(156, 220, 254);"> className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"fixed inset-0 -z-10 bg-gradient-to-r from-black/95 via-black/80 to-black/60"</span><span style="color: rgb(244, 71, 71);"> /</span><span style="color: rgb(128, 128, 128);">&gt;</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">{/* Optional cyan tech grid overlay */}</span></span>
<span class="line"><span style="color: rgb(128, 128, 128);">&lt;</span><span style="color: rgb(86, 156, 214);">div</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">  className</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">"fixed inset-0 -z-10 opacity-[0.07] pointer-events-none"</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">  style</span><span style="color: rgb(230, 230, 230);">=</span><span style="color: rgb(206, 145, 120);">{{</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">    backgroundImage:</span><span style="color: rgb(156, 220, 254);"> `</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">      linear-gradient(rgba(232,</span><span style="color: rgb(156, 220, 254);"> 33,</span><span style="color: rgb(156, 220, 254);"> 39,</span><span style="color: rgb(156, 220, 254);"> 0.4)</span><span style="color: rgb(156, 220, 254);"> 1px,</span><span style="color: rgb(156, 220, 254);"> transparent</span><span style="color: rgb(156, 220, 254);"> 1px),</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">      linear-gradient(90deg,</span><span style="color: rgb(156, 220, 254);"> rgba(232,</span><span style="color: rgb(156, 220, 254);"> 33,</span><span style="color: rgb(156, 220, 254);"> 39,</span><span style="color: rgb(156, 220, 254);"> 0.4)</span><span style="color: rgb(156, 220, 254);"> 1px,</span><span style="color: rgb(156, 220, 254);"> transparent</span><span style="color: rgb(156, 220, 254);"> 1px)</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">    `,</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">    backgroundSize:</span><span style="color: rgb(244, 71, 71);"> "48px</span><span style="color: rgb(156, 220, 254);"> 48px</span><span style="color: rgb(244, 71, 71);">",</span></span>
<span class="line"><span style="color: rgb(156, 220, 254);">  }}</span></span>
