<span class="line"><span style="color: rgb(86, 156, 214);">const</span><span style="color: rgb(156, 220, 254);"> accent</span><span style="color: rgb(212, 212, 212);"> =</span><span style="color: rgb(206, 145, 120);"> "#E82127"</span><span style="color: rgb(230, 230, 230);">;</span></span>
