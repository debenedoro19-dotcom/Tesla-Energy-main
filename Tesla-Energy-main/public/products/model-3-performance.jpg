    :host {
      all: initial;
      position: fixed;
      z-index: 2147483646;
      display: inline-flex;
      align-items: center;
      pointer-events: auto;
    }

    .sbpo-shell {
      position: relative;
      display: inline-flex;
      align-items: center;
      z-index: 2147483647;
      isolation: isolate;
    }

    :host(.sbpo-hidden) {
      display: none;
    }

    :host(.sbpo-inline) {
      position: relative;
      z-index: 2147483646;
      margin-right: 4px;
      align-self: center;
      isolation: isolate;
    }

    .sbpo-optimize {
      all: unset;
      box-sizing: border-box;
      width: 32px;
      height: 32px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(119, 119, 119, 0.47);
      color: #ffffff;
      position: relative;
      z-index: 2147483647;
      pointer-events: auto;
      overflow: visible;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 0 0 1px rgba(0, 0, 0, 0.12),
        0 2px 8px rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(10px) saturate(130%);
      -webkit-backdrop-filter: blur(10px) saturate(130%);
      transition: background 140ms ease, transform 140ms ease, opacity 140ms ease, color 140ms ease;
    }

    .sbpo-optimize svg {
      width: 16px;
      height: 16px;
      display: block;
    }

    .sbpo-optimize-image {
      width: 16px;
      height: 16px;
      display: block;
      object-fit: contain;
      pointer-events: none;
    }

    .sbpo-optimize:hover {
      transform: translateY(-1px);
      background: rgba(96, 96, 96, 0.58);
    }

    .sbpo-optimize[data-open="true"] {
      background: rgba(86, 86, 86, 0.64);
      transform: translateY(-1px);
    }

    .sbpo-optimize:disabled {
      cursor: default;
      opacity: 0.72;
      transform: none;
    }

    .sbpo-menu {
      position: fixed;
      top: 0;
      left: 0;
      width: min(264px, calc(100vw - 24px));
      padding: 10px;
      border-radius: 18px;
      background: rgba(20, 20, 20, 0.92);
      color: #f7f7f7;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: grid;
      gap: 8px;
      transform-origin: top right;
      z-index: 2147483647;
    }

    .sbpo-menu[hidden] {
      display: none;
    }

    .sbpo-menu-item {
      all: unset;
      box-sizing: border-box;
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      cursor: pointer;
      color: inherit;
      text-align: left;
      transition: background 120ms ease, opacity 120ms ease;
    }

    .sbpo-menu-item[hidden] {
      display: none !important;
    }

    .sbpo-menu-item:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .sbpo-menu-item:disabled {
      cursor: default;
      opacity: 0.45;
    }

    .sbpo-menu-item svg {
      width: 18px;
      height: 18px;
      display: block;
      margin-top: 1px;
    }

    .sbpo-menu-copy {
      min-width: 0;
      display: grid;
      gap: 4px;
    }

    .sbpo-menu-label {
      font-size: 13px;
      font-weight: 700;
      line-height: 1.3;
      white-space: normal;
    }

    .sbpo-menu-hint {
      font-size: 12px;
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.72);
      white-space: normal;
    }

    :host([data-sb-state="error"]) .sbpo-optimize {
      background: #b3261e;
      border-color: rgba(255, 255, 255, 0.24);
    }

    :host([data-sb-state="success"]) .sbpo-optimize {
      background: #0f8a37;
      border-color: rgba(255, 255, 255, 0.24);
    }

    :host([data-sb-mode="undo"]) .sbpo-optimize {
      background: #f6f8fa;
      border-color: #d0d7de;
      color: #1f2328;
    }

    :host([data-sb-state="loading"]) .sbpo-optimize {
      box-shadow: 0 0 0 1px rgba(147, 201, 255, 0.35), 0 0 10px rgba(128, 188, 255, 0.32);
    }

    :host([data-sb-state="loading"]) .sbpo-optimize .sbpo-optimize-image {
      animation: none;
    }

    :host([data-sb-state="loading"]) .sbpo-optimize::before,
    :host([data-sb-state="loading"]) .sbpo-optimize::after {
      content: "";
      position: absolute;
      pointer-events: none;
      border-radius: 999px;
    }

    :host([data-sb-state="loading"]) .sbpo-optimize::before {
      inset: -5px;
      border: 1.4px solid transparent;
      border-top-color: rgba(171, 222, 255, 0.95);
      border-right-color: rgba(111, 185, 255, 0.88);
      opacity: 0.92;
      animation: sbpo-spin-fast 0.45s linear infinite;
    }

    :host([data-sb-state="loading"]) .sbpo-optimize::after {
      inset: -4px;
      background: radial-gradient(circle, rgba(99, 170, 255, 0.25) 0%, rgba(99, 170, 255, 0.08) 48%, rgba(99, 170, 255, 0) 76%);
      filter: blur(0.8px);
      opacity: 0.84;
      animation: sbpo-glow-pulse 1.4s ease-in-out infinite;
    }

    :host(.sbpo-chatgpt) .sbpo-optimize {
      width: 36px;
      height: 36px;
      border: 0;
      box-shadow: none;
      background: transparent;
      color: #ffffff;
      opacity: 0.9;
    }

    :host(.sbpo-chatgpt) .sbpo-optimize:hover {
      transform: none;
      opacity: 1;
      background: rgba(127, 127, 127, 0.18);
    }

    :host(.sbpo-chatgpt[data-sb-state="loading"]) .sbpo-optimize {
      background: rgba(127, 127, 127, 0.16);
      box-shadow: 0 0 0 1px rgba(166, 209, 255, 0.25), 0 0 10px rgba(111, 170, 255, 0.22);
    }

    :host(.sbpo-chatgpt[data-sb-mode="undo"]) .sbpo-optimize {
      background: rgba(127, 127, 127, 0.24);
      color: #ffffff;
    }

    :host(.sbpo-chatgpt[data-sb-state="error"]) .sbpo-optimize {
      color: #ff8f86;
      background: rgba(179, 38, 30, 0.2);
    }

    :host(.sbpo-chatgpt[data-sb-state="success"]) .sbpo-optimize {
      color: #6ddc8b;
      background: rgba(15, 138, 55, 0.18);
    }

    :host(.sbpo-meta.sbpo-inline) {
      margin-right: 0;
    }

    :host(.sbpo-meta) .sbpo-optimize {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      box-shadow: none;
    }

    :host(.sbpo-meta) .sbpo-optimize-image {
      width: 16px;
      height: 16px;
    }

    :host(.sbpo-deepseek.sbpo-inline) {
      margin-left: 4px;
      margin-right: 4px;
    }

    :host(.sbpo-deepseek) .sbpo-optimize {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      box-shadow: none;
    }

    :host(.sbpo-deepseek) .sbpo-optimize-image {
      width: 16px;
      height: 16px;
    }

    :host(.sbpo-grok.sbpo-inline) {
      margin-right: 0;
    }

    :host(.sbpo-grok) .sbpo-optimize {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      box-shadow: none;
    }

    :host(.sbpo-grok) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-claude.sbpo-inline) {
      margin-right: 0;
    }

    :host(.sbpo-claude) .sbpo-optimize {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      box-shadow: none;
    }

    :host(.sbpo-claude) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-gemini.sbpo-inline) {
      margin-right: 6px;
    }

    :host(.sbpo-gemini) .sbpo-optimize {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      box-shadow: none;
    }

    :host(.sbpo-gemini) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-perplexity.sbpo-inline) {
      margin-right: 2px;
    }

    :host(.sbpo-perplexity) .sbpo-optimize {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
      border: 1px solid rgba(148, 163, 184, 0.42);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
      background: rgba(226, 232, 240, 0.9);
      color: #374151;
      opacity: 1;
    }

    :host(.sbpo-perplexity) .sbpo-optimize:hover {
      transform: none;
      opacity: 1;
      border-color: rgba(100, 116, 139, 0.5);
      background: rgba(203, 213, 225, 0.96);
    }

    :host(.sbpo-perplexity) .sbpo-optimize[data-open="true"] {
      border-color: rgba(99, 102, 241, 0.28);
      background: rgba(238, 242, 255, 0.98);
      color: #4338ca;
    }

    :host(.sbpo-perplexity) .sbpo-optimize svg {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-perplexity) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-copilot.sbpo-inline) {
      margin-right: 2px;
    }

    :host(.sbpo-copilot) .sbpo-optimize {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      border: 1px solid rgba(109, 117, 141, 0.36);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
      background: rgba(226, 232, 240, 0.86);
      color: #374151;
      opacity: 1;
    }

    :host(.sbpo-copilot) .sbpo-optimize:hover {
      transform: none;
      opacity: 1;
      border-color: rgba(109, 117, 141, 0.52);
      background: rgba(203, 213, 225, 0.92);
    }

    :host(.sbpo-copilot) .sbpo-optimize[data-open="true"] {
      border-color: rgba(74, 110, 224, 0.3);
      background: rgba(243, 246, 255, 0.98);
      color: #3659b5;
    }

    :host(.sbpo-copilot) .sbpo-optimize svg {
      width: 18px;
      height: 18px;
    }

    :host(.sbpo-copilot) .sbpo-optimize-image {
      width: 18px;
      height: 18px;
    }

    @keyframes sbpo-spin-fast {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes sbpo-glow-pulse {
      0% {
        transform: scale(0.95);
        opacity: 0.56;
      }
      55% {
        transform: scale(1.05);
        opacity: 0.92;
      }
      100% {
        transform: scale(0.95);
        opacity: 0.56;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :host([data-sb-state="loading"]) .sbpo-optimize .sbpo-optimize-image,
      :host([data-sb-state="loading"]) .sbpo-optimize::before,
      :host([data-sb-state="loading"]) .sbpo-optimize::after {
        animation: none;
      }
    }
